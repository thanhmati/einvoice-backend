{
  "name": "@einvoice-backend/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx:reset": "nx reset",
    "nx:run-many": "nx run-many",
    "lint": "pnpm run nx:run-many --target=lint",
    "fix": "pnpm run nx:run-many --target=lint --fix",
    "nx:affected": "nx affected --parallel=2 --nxBail",
    "docker-build": "pnpm nx:run-many --target=docker-build --verbose",
    "docker:start:provider": "docker compose -f docker-compose.provider.yaml up -d",
    "docker:start:dev": "docker compose -f docker-compose.dev.yaml up -d",
    "build": "pnpm nx:run-many -t build && pnpm docker-build && pnpm docker:start:provider && pnpm docker:start:dev",
    "dev": "pnpm nx:reset && pnpm nx:run-many -t serve",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "axios": "^1.6.0",
    "express": "^5.1.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "21.2.1",
    "@nx/eslint-plugin": "21.2.1",
    "@nx/jest": "21.2.1",
    "@nx/js": "21.2.1",
    "@nx/nest": "21.2.1",
    "@nx/node": "21.2.1",
    "@nx/web": "21.2.1",
    "@nx/webpack": "21.2.1",
    "@nx/workspace": "21.2.1",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/node": "~18.16.9",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^16.1.2",
    "nx": "21.2.1",
    "prettier": "^2.6.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.29.0",
    "webpack-cli": "^5.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
