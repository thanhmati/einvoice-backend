{
  "name": "@invoice/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx:reset": "nx reset",
    "nx:run-many": "nx run-many",
    "lint": "pnpm run nx:run-many --target=lint",
    "fix": "pnpm run nx:run-many --target=lint --fix",
    "nx:affected": "nx affected --parallel=2 --nxBail",
    "docker-build": "pnpm nx:run-many --target=docker-build --verbose",
    "docker:start:provider": "docker compose -f docker-compose.provider.yaml up -d",
    "docker:start:dev": "docker compose -f docker-compose.dev.yaml up -d",
    "build": "pnpm nx:run-many -t build && pnpm docker-build && pnpm docker:start:provider && pnpm docker:start:dev",
    "dev": "pnpm nx:reset && pnpm nx:run-many -t serve",
    "dev-lite": "pnpm dev --projects=bff,invoice,authorizer,user-access",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@keyv/redis": "^5.1.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.4",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.4",
    "@nestjs/microservices": "^11.1.4",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.4",
    "@nestjs/swagger": "^11.2.0",
    "axios": "^1.10.0",
    "cache-manager": "^7.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.7.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.18.0",
    "mongoose": "^8.16.4",
    "mongoose-paginate-v2": "^1.9.1",
    "nodemailer": "^7.0.5",
    "puppeteer": "^24.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "streamifier": "^0.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.31.0",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.4",
    "@nx/eslint": "21.2.4",
    "@nx/eslint-plugin": "21.2.4",
    "@nx/jest": "21.2.4",
    "@nx/js": "21.2.4",
    "@nx/nest": "21.2.4",
    "@nx/node": "21.2.4",
    "@nx/web": "21.2.4",
    "@nx/webpack": "21.2.4",
    "@nx/workspace": "21.2.4",
    "@swc-node/register": "~1.10.10",
    "@swc/core": "~1.12.14",
    "@swc/helpers": "~0.5.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "~24.0.14",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jest-environment-node": "^30.0.4",
    "jsonc-eslint-parser": "^2.4.0",
    "lint-staged": "^16.1.2",
    "nx": "21.2.4",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.37.0",
    "webpack-cli": "^6.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
