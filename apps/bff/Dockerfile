FROM node:20-alpine

WORKDIR /app

# Copy built artifacts from dist (generated by nx affected -t prune)
COPY dist/apps/bff ./

# Install pnpm for dependency installation
RUN npm install -g pnpm@10.19.0

# Install production dependencies
# prune-lockfile generates package.json and pnpm-lock.yaml in dist
RUN if [ -f package.json ]; then pnpm install --prod --frozen-lockfile; fi
RUN pnpm install tslib

CMD ["node", "main.js"]
